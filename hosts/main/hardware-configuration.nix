# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.
#
# Файл содержит ТОЛЬКО сгенерированные значения. Всё, что было добавлено
# вручную (драйвер NVIDIA, bluetooth, logitech, параметры ядра), перенесено в
# modules/nixos/hardware.nix.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # Модули ядра, нужные на раннем этапе загрузки (NVMe, USB, SATA).
  boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "ahci" "usb_storage" "usbhid" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  # Виртуализация KVM для процессоров AMD.
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  # Корневой раздел.
  fileSystems."/" = {
    device = "/dev/disk/by-uuid/bd0c2c9d-cc7c-4c71-a3df-9c27b392826d";
    fsType = "ext4";
  };

  # EFI-раздел; fmask/dmask=0077 — доступ только для root.
  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/3FD5-487F";
    fsType = "vfat";
    options = [ "fmask=0077" "dmask=0077" ];
  };

  swapDevices = [ { device = "/dev/disk/by-uuid/b6e4c3bc-177f-4506-83c8-1d971fe21641"; } ];

  # DHCP на всех интерфейсах (скриптовая сеть NixOS).
  networking.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  # Микрокод AMD из redistributable-прошивок.
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
